PORT=4000

# Local Docker Postgres. For Supabase use the pooler string from
# Project Settings -> Database -> Connection pooling (IPv4), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/agentic_calendar_app_db

# Frontend origin(s) allowed by CORS, comma-separated (e.g. add your Vercel URL)
APP_URL=http://localhost:3000

DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=

DESCOPE_CALENDAR_CONNECTION_ID=google-calendar

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AI_MODEL=gemini-3.8-flash

# Or use OpenAI instead (used only when GEMINI_API_KEY is empty)
# OPENAI_API_KEY=

# Optional: enables the MCP endpoint (POST /mcp)
SERVER_URL=http://localhost:4000
DESCOPE_MCP_SERVER_WELL_KNOWN_URL=
